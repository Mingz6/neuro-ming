## Pick a provider. Keys are read from shell env vars (set in secrets.zsh).
## Just change LLM_PROVIDER and MODEL_NAME here.

## ollama (free, local) — run `brew install ollama && ollama pull llama3.1`
LLM_PROVIDER=ollama
MODEL_NAME=llama3.1

## openai — set OPENAI_API_KEY in your shell env
# LLM_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini

## groq (free tier) — set GROQ_API_KEY in your shell env
# LLM_PROVIDER=groq
# MODEL_NAME=llama-3.1-8b-instant

## together ($5 free credit) — set TOGETHER_API_KEY in your shell env
# LLM_PROVIDER=together
# MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo

## azure-openai — set AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT in your shell env
# LLM_PROVIDER=azure-openai
# MODEL_NAME=gpt-5.4
# MODEL_NAME_FAST=gpt-5.4-mini   # cheap model for casual chat (dual-loop)
# LLM_FALLBACK_MODELS=gpt-5.4,gpt-4.1

## openrouter — set OPENROUTER_API_KEY in your shell env
# LLM_PROVIDER=openrouter
# MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

## CORS — comma-separated origins allowed to call the API (for embedded widget)
CORS_ORIGINS=http://localhost:4321,https://mingz.dev,https://ca-neuro-ming.ashydesert-c580ee2f.canadacentral.azurecontainerapps.io

## TTS — text-to-speech via Azure OpenAI (separate resource from chat LLM)
# TTS_ENABLED=true
# TTS_API_KEY=your-tts-azure-openai-key
# TTS_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
# TTS_DEPLOYMENT=tts
# TTS_VOICE=nova
# TTS_FORMAT=mp3
